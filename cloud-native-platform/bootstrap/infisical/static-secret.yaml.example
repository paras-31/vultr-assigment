# Fill INFISICAL_PROJECT_ID then apply. Do not put Client ID/Secret in this file.
apiVersion: secrets.infisical.com/v1beta1
kind: InfisicalStaticSecret
metadata:
  name: app-secrets
  namespace: infisical-system
spec:
  infisicalAuthRef:
    name: infisical-universal-auth
    namespace: infisical-system
  syncOptions:
    refreshInterval: 1m
    instantUpdates: false
  sources:
    - projectId: YOUR_INFISICAL_PROJECT_ID
      environmentSlug: prod
      secretPath: /
  targets:
    - name: app-secrets
      namespace: apps
      kind: Secret
      creationPolicy: Owner
    - name: postgres-auth
      namespace: databases
      kind: Secret
      creationPolicy: Owner
      template:
        engineVersion: v1
        data:
          password: "{{ .POSTGRES_PASSWORD.Value }}"
    - name: valkey-auth
      namespace: databases
      kind: Secret
      creationPolicy: Owner
      template:
        engineVersion: v1
        data:
          password: "{{ .VALKEY_PASSWORD.Value }}"
    - name: qdrant-auth
      namespace: databases
      kind: Secret
      creationPolicy: Owner
      template:
        engineVersion: v1
        data:
          api-key: "{{ .QDRANT_API_KEY.Value }}"
